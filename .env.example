# Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# Matches the local Docker Compose defaults (compose.yaml). Development only.
DATABASE_URL=postgres://politics:politics_dev_password@localhost:5432/politics_game

# Optional: debug | info | warn | error | silent
# Default: info, or silent under NODE_ENV=test. Setting it here also applies to tests.
# LOG_LEVEL=info

# Optional overrides read by compose.yaml
# POSTGRES_USER=politics
# POSTGRES_PASSWORD=politics_dev_password
# POSTGRES_DB=politics_game
# POSTGRES_PORT=5432

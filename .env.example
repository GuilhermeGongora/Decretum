# Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# Matches the local Docker Compose defaults (compose.yaml). Development only.
DATABASE_URL=postgres://decretum:decretum_dev_password@localhost:5432/decretum

# Connections each process keeps open. Local development is one process serving many requests, so a
# handful is right. On a serverless host every function instance gets its own pool: set this to 1 and
# point DATABASE_URL at a transaction-mode pooler.
# DATABASE_POOL_MAX=10

# Optional: debug | info | warn | error | silent
# Default: info, or silent under NODE_ENV=test. Setting it here also applies to tests.
# LOG_LEVEL=info

# Optional overrides read by compose.yaml
# POSTGRES_USER=decretum
# POSTGRES_PASSWORD=decretum_dev_password
# POSTGRES_DB=decretum
# POSTGRES_PORT=5432

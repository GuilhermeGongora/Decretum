{
  "name": "decretum",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON node_modules/jest/bin/jest.js",
    "test:watch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON node_modules/jest/bin/jest.js --watch",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "db:rollback": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down",
    "db:migrate:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.test node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env seeds/run.mjs",
    "db:seed:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.test seeds/run.mjs",
    "db:create-migration": "node node_modules/node-pg-migrate/bin/node-pg-migrate.js create --migration-file-language js",
    "assets:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-assets.mjs",
    "simulate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/simulate.mjs",
    "commit": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.6"
  }
}

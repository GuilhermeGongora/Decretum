# Versioned on purpose: local-only test defaults, no real secrets.
# Loaded by Jest (via next/jest) with priority over .env, and by `npm run db:migrate:test`.
# Variables already set in the environment (e.g. in CI) take precedence.
DATABASE_URL=postgres://decretum:decretum_dev_password@localhost:5432/decretum_test

# The suite drives the API far harder than any player would, so the limiter is off here. The test that
# covers the limiter turns it back on for itself.
RATE_LIMIT_DISABLED=1
